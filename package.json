{
  "name": "bbcafe-app",
  "version": "2.0.0",
  "description": "LINE message viewer for BB Cafe private group use.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:security": "node --test scripts/security-audit-policy.test.mjs",
    "audit:security": "node scripts/security-audit.mjs",
    "test:firebase": "npx --yes firebase-tools@15.32.1 emulators:exec --only auth,firestore --project demo-bbcafe-security --config scripts/firebase-smoke.config.json \"node scripts/firebase-security-smoke.mjs\"",
    "typegen": "next typegen",
    "typecheck": "tsc --noEmit",
    "generate-vapid-keys": "node scripts/generate-vapid-keys.mjs",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bamboosato/bbcafe-app.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Bamboosato/bbcafe-app/issues"
  },
  "homepage": "https://github.com/Bamboosato/bbcafe-app#readme",
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "next": "^16.3.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.5"
    },
    "postcss": "^8.5.14",
    "uuid": "^11.1.1"
  }
}
